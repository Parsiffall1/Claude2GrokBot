# Worker SECRETS for Claude2GrokBot. Placeholders only — never put real values in this file.
#
# Production: set each one with  npx wrangler secret put NAME   (you will be prompted for the value)
# Local dev:  copy this file to .env (git-ignored) and fill in test values, then  npm run dev
# The "Deploy to Cloudflare" button also reads this file to ask you for these values.
#
# Generate random values with:  openssl rand -hex 32
# (Windows PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# Bearer token(s) for MCP clients like Claude Code. >= 32 chars. Comma-separate several to rotate.
MCP_TOKENS=replace-with-openssl-rand-hex-32

# Key the executor uses to claim tasks (also goes into the executor's own config). >= 32 chars.
EXECUTOR_KEY=replace-with-openssl-rand-hex-32

# Password for the OAuth consent screen (claude.ai connector). >= 12 chars.
OWNER_PASSWORD=replace-with-a-long-passphrase

# Executor wake webhook. Grok Bot: the routine webhook "POST to" URL and its "key". Use WAKE_URL=none for poll-only.
WAKE_URL=none
WAKE_SECRET=replace-with-the-routine-webhook-key

# ---- optional (uncomment to use) ----
# Read-only MCP tokens (status/results only), e.g. for unattended Claude routines.
# MCP_READONLY_TOKENS=

# Push notifications for alerts (executor unreachable / not claiming), any ntfy-compatible URL, e.g. https://ntfy.sh/<long-random-topic>
# NOTIFY_URL=
# NOTIFY_TOKEN=

# More executors (advanced; see docs/adapters.md):
# EXECUTORS_JSON={"laptop":{"wake_url":"https://example.com/hook","wake_auth":"hmac","wake_secret":"...","executor_key":"..."}}
