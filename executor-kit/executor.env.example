# Copy to ~/.config/claude2grokbot/executor.env on the EXECUTOR's machine, then: chmod 600 ~/.config/claude2grokbot/executor.env
# (or provide the same names as environment variables / your executor's secret store).
# Never commit the real file.

# Your Claude2GrokBot server, no trailing slash
RELAY_URL=https://claude2grokbot.your-subdomain.workers.dev

# Must equal the EXECUTOR_KEY secret set on the server (openssl rand -hex 32)
RELAY_EXECUTOR_KEY=replace-with-your-executor-key

# Optional: which executor this machine is (default: the server's DEFAULT_EXECUTOR)
# RELAY_EXECUTOR=default
